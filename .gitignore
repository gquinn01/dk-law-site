# Regenerated by scripts/audit.py on every run, so it is never worth
# committing. Run the script to get a current one.
audit-report.md

# Python writes this next to any module it imports, and
# scripts/test-sitemap-expansion.py imports scripts/audit.py, so the
# pre-commit run in CLAUDE.md leaves one behind every time. Ignored so
# git status stays quiet about a folder that is pure build output.
__pycache__/

# macOS Finder junk. It appeared in a staged diff on 2026-08-31.
.DS_Store

# Scratch files the report agents write a long issue body into, then pass
# to `gh issue create --body-file`. A Bash command over roughly 5KB is
# refused by the command parser, and a full weekly report is bigger than
# that, so the body cannot go on the command line. Runner-only, but
# ignored so a local test run cannot commit one.
.audit-issue-body.md
.gw-comment.md

# Regenerated by scripts/fetch_seo_news.py on every Google Watcher run,
# for the same reason audit-report.md is ignored above: it is the input to
# one run and stale the moment that run ends.
seo-news.md

# The firm's own photographs, banked on this machine and never pushed,
# because this repo is public. Only cropped, redacted, metadata-stripped
# derivatives ever land under docs/.
photo-bank/
